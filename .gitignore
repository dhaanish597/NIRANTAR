# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/
