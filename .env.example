# Copy to .env and fill in. Phase 0's stub pipeline does not read any of these yet —
# they exist now so later phases (DB, real ingest adapters) don't need a schema change here.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Phase 1+; Phase 0 pipeline runs with no DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nirantar
POSTGRES_USER=nirantar
POSTGRES_PASSWORD=nirantar_dev_only
DATABASE_URL=postgresql://nirantar:nirantar_dev_only@localhost:5432/nirantar
# SQLite fallback for laptop-only demo (CLAUDE.md stack table) — Phase 1+.
SQLITE_FALLBACK_PATH=./data/dev.sqlite3

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Vite reads these at build/dev time, must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/ticks

# --- External data sources (Phase 1+, not used by Phase 0 stub pipeline) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
IMD_API_KEY=
