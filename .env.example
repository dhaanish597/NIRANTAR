# Copy to .env and fill in.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL / SQLite fallback) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nirantar
POSTGRES_USER=nirantar
POSTGRES_PASSWORD=nirantar_dev_only
DATABASE_URL=postgresql://nirantar:nirantar_dev_only@localhost:5432/nirantar
SQLITE_FALLBACK_PATH=./data/dev.sqlite3

# --- Neo4j AuraDB (Multiplex Spatial-Temporal & Cascading Infrastructure Graph) ---
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Sovereign Sarvam AI Multimodal Suite (Saaras v4 STT, Sarvam Vision OCR, Bulbul v4 Flash TTS) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_VISION_MODEL=sarvam-vision

# --- Neuro-Symbolic Agent Orchestrator & Model Routing ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=3
AGENT_FAST_MODEL=meta/llama-3.1-8b-instruct
AGENT_REASONING_MODEL=meta/llama-3.1-70b-instruct
AGENT_MAX_ITERATIONS=5

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Vite reads these at build/dev time, must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/ticks

# --- External data sources ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
IMD_API_KEY=
